{
  "name": "ice-rates-terminal",
  "version": "1.4.1",
  "description": "ICE Rates Terminal: official CBN, Nigerian bank and live market rates for the naira, currencies and crypto",
  "main": "main.js",
  "author": "ICE",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test.js",
    "dist": "electron-builder --win nsis portable --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ice.ecurrencyconverter",
    "productName": "ICE Rates Terminal",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ICE Rates Terminal"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR_GITHUB_USERNAME",
        "repo": "ice-rates-terminal"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}